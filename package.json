{
  "name": "auto-claim-lark",
  "version": "0.1.0",
  "private": true,
  "description": "飞书费用报销与分批借款核销机器人：发票 OCR → 聊天确认 → 自动创建审批",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:local": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test tests/writeoff.test.cjs tests/invoice-dedup.test.cjs",
    "inspect:approval": "tsx scripts/inspect-approval.ts"
  },
  "keywords": [
    "feishu",
    "lark",
    "bot",
    "ocr",
    "invoice",
    "approval"
  ],
  "license": "MIT",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "dotenv": "^17.4.2",
    "heic-convert": "^2.1.0",
    "jsqr": "1.4.0",
    "jszip": "^3.10.1",
    "pdf-to-img": "^6.2.0"
  },
  "overrides": {
    "pdf-to-img": {
      "pdfjs-dist": "^6.2.108"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
