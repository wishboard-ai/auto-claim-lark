# ==== 飞书应用凭证 ====
# 在开放平台 -> 应用 -> 凭证与基础信息 获取
FEISHU_APP_ID=cli_aae9aaa7beb8dce3
FEISHU_APP_SECRET=

# ==== 费用报销审批 ====
# 审批定义 code。获取方式：
#   1) 飞书「审批」管理后台 -> 打开该审批 -> URL 中的 definitionCode
#   2) 或运行： npm run inspect:approval -- <approval_code> 查看表单字段
APPROVAL_CODE=

# ==== 运行参数 ====
# 提交模式： confirm（识别后聊天中确认再提交，默认） | direct（识别后直接提交）
SUBMIT_MODE=confirm

# 日志级别： debug | info | warn | error
LOG_LEVEL=info

# 域名： feishu(国内) | lark(国际)
FEISHU_DOMAIN=feishu
