# ==== 飞书应用凭证 ====
# 在开放平台 -> 应用 -> 凭证与基础信息 获取
FEISHU_APP_ID=cli_aae9aaa7beb8dce3
FEISHU_APP_SECRET=

# ==== 审批定义 ====
# 审批定义 code。获取方式：
#   1) 飞书「审批」管理后台 -> 打开该审批 -> URL 中的 definitionCode
#   2) 或运行： npm run inspect:approval -- <approval_code> 查看表单字段
APPROVAL_CODE=75DCE71F-7160-4966-9DE5-D4B0E3E34A9B
EXPENSE_APPROVAL_CODE=08835DC3-456D-4EC8-BC60-D4433588821C

# ==== 运行参数 ====
# 提交模式： confirm（识别后聊天中确认再提交，默认） | direct（识别后直接提交）
SUBMIT_MODE=confirm

# 借款核销：关联已审批通过的付款申请；实际借款时间取该审批实例的 end_time；支持按余额分批核销
LOAN_WRITE_OFF_ENABLED=true
LOAN_APPROVAL_CODE=FC505937-DA1D-471E-AC90-13C7AEB306B7
LOAN_LOOKBACK_DAYS=365
LOAN_WRITE_OFF_LEDGER_PATH=data/loan-writeoff-ledger.json

# 发票跨费用报销/借款核销检重台账（提交过的发票不可再次使用）
INVOICE_USAGE_LEDGER_PATH=data/invoice-usage-ledger.json

# 日志级别： debug | info | warn | error
LOG_LEVEL=info

# 域名： feishu(国内) | lark(国际)
FEISHU_DOMAIN=feishu

# 网络请求超时(ms)：识别/文案/上传等调用超过该时间未响应即中止，避免挂起阻塞用户消息队列。
# 默认 120000(120s)。本地 Ollama 视觉模型较慢的机器可适当调大（如 180000）。
REQUEST_TIMEOUT_MS=120000

# ==== 发票识别 OCR ====
# OCR_PROVIDER 选择识别后端：
#   openai —— OpenAI 兼容多模态大模型（云端 qwen-vl-max，或本地 Ollama qwen2.5vl）。默认。
#   paddle —— 本地 PaddleOCR 微服务（全本地、零成本，适合低配/无GPU机器）。见 ocr/README.md。
OCR_PROVIDER=openai

# --- provider=openai 时的设置 ---
# 识别模型（百炼）：qwen-vl-max（推荐，票种分类/价税合计更准） | qwen3-vl-plus | qwen-vl-plus
# 默认复用下方 LLM_API_KEY / LLM_BASE_URL（同一百炼业务空间），只需保证 LLM_API_KEY 已填。
OCR_MODEL=qwen-vl-max
# OCR_API_KEY=          # 留空则复用 LLM_API_KEY
# OCR_BASE_URL=         # 留空则复用 LLM_BASE_URL

# --- provider=paddle 时的设置（全本地）---
# 先启动本地服务： cd ocr && ./start-ocr.sh
# 然后设置：
#   OCR_PROVIDER=paddle
#   OCR_BASE_URL=http://localhost:8000
# （paddle 模式忽略 OCR_MODEL / OCR_API_KEY）

# ==== 可选：LLM（用于生成标题/核销事由/整理明细内容）====
# 兼容 OpenAI Chat Completions 接口。留空 LLM_API_KEY 则不启用，使用模板生成。
# 例：OpenAI -> https://api.openai.com/v1 ；DeepSeek -> https://api.deepseek.com/v1
#     阿里云百炼(通义千问) -> https://dashscope.aliyuncs.com/compatible-mode/v1 （模型如 qwen-flash / qwen3.6-flash）
# 注意：当 OCR_PROVIDER=openai 且未单独配 OCR_API_KEY 时，OCR 会复用此处 key/base_url。
# 若用 paddle 全本地方案，标题生成可留空（回退模板），或指向本地 Ollama 文本模型。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
