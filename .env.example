# ==== 飞书应用凭证 ====
# 在开放平台 -> 应用 -> 凭证与基础信息 获取
FEISHU_APP_ID=cli_aae9aaa7beb8dce3
FEISHU_APP_SECRET=

# ==== 费用报销审批 ====
# 审批定义 code。获取方式：
#   1) 飞书「审批」管理后台 -> 打开该审批 -> URL 中的 definitionCode
#   2) 或运行： npm run inspect:approval -- <approval_code> 查看表单字段
APPROVAL_CODE=

# ==== 运行参数 ====
# 提交模式： confirm（识别后聊天中确认再提交，默认） | direct（识别后直接提交）
SUBMIT_MODE=confirm

# 日志级别： debug | info | warn | error
LOG_LEVEL=info

# 域名： feishu(国内) | lark(国际)
FEISHU_DOMAIN=feishu

# ==== 可选：LLM（用于生成标题/报销事由/整理明细内容）====
# 兼容 OpenAI Chat Completions 接口。留空 LLM_API_KEY 则不启用，使用模板生成。
# 例：OpenAI -> https://api.openai.com/v1 ；DeepSeek -> https://api.deepseek.com/v1
#     阿里云百炼(通义千问) -> https://dashscope.aliyuncs.com/compatible-mode/v1 （模型如 qwen-flash / qwen3.6-flash）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
